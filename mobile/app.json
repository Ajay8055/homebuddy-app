{
  "expo": {
    "name": "HomeBuddy",
    "slug": "homebuddy",
    "scheme": "homebuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.homebuddy.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#557765"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow HomeBuddy to use your microphone for voice commands.",
          "speechRecognitionPermission": "Allow HomeBuddy to convert your speech into household commands.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ]
  }
}
